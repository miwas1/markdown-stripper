rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthorizedAdmin() {
      return request.auth != null && 
             request.auth.token.email.lower() == 'odebunmiwasiu124@gmail.com';
    }

    // Traffic events can be created by anyone (anonymous user traffic tracking)
    // Only the authorized admin email can read traffic logs and analytics
    match /traffic_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAuthorizedAdmin();
    }

    // Daily stats aggregate
    match /daily_stats/{dayId} {
      allow create, update: if true;
      allow read, delete: if isAuthorizedAdmin();
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if isAuthorizedAdmin();
    }
  }
}
